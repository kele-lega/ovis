diff --git a/src/pane/launch_command.rs b/src/pane/launch_command.rs
new file mode 100644
index 00000000..f50abb46
--- /dev/null
+++ b/src/pane/launch_command.rs
@@ -0,0 +1,85 @@
+//! Validated, ephemeral creation policy. Never serialize into session state.
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct LaunchCommand(String);
+
+pub(crate) const SUPPORTED: bool = cfg!(unix);
+
+impl LaunchCommand {
+    pub(crate) fn new(command: String) -> std::io::Result<Self> {
+        if !SUPPORTED {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::Unsupported,
+                "atomic command launch is supported only on Unix",
+            ));
+        }
+        if command.trim().is_empty()
+            || command.encode_utf16().count() > 2000
+            || command
+                .chars()
+                .any(|ch| ch.is_control() || matches!(ch, '\u{2028}' | '\u{2029}'))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "command must be a nonblank single line of at most 2000 UTF-16 code units without control characters",
+            ));
+        }
+        Ok(Self(command))
+    }
+
+    pub(crate) fn as_str(&self) -> &str {
+        &self.0
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn atomic_command_launch_rejects_blank_controls_and_line_separators() {
+        for command in [
+            "",
+            "   ",
+            "\t",
+            "echo\nhi",
+            "echo\rhi",
+            "echo\0hi",
+            "echo\u{7f}",
+            "echo\u{85}",
+            "echo\u{2028}hi",
+            "echo\u{2029}hi",
+        ] {
+            assert!(LaunchCommand::new(command.into()).is_err(), "{command:?}");
+        }
+    }
+
+    #[cfg(unix)]
+    #[test]
+    fn atomic_command_launch_preserves_text_and_matches_js_length() {
+        let command = "  A='two words' printf '%s' \"$A\" | cat ; echo \u{1f600}  ";
+        let validated = LaunchCommand::new(command.into()).unwrap();
+        assert_eq!(validated.as_str(), command);
+        assert_eq!(
+            crate::platform::pane_custom_command_pty_builder(validated.as_str()).get_argv(),
+            &[
+                std::ffi::OsString::from("/bin/sh"),
+                "-c".into(),
+                command.into()
+            ]
+        );
+        assert!(LaunchCommand::new("a".repeat(2000)).is_ok());
+        assert!(LaunchCommand::new("a".repeat(2001)).is_err());
+        assert!(LaunchCommand::new("\u{1f600}".repeat(1000)).is_ok());
+        assert!(LaunchCommand::new("\u{1f600}".repeat(1001)).is_err());
+    }
+
+    #[cfg(not(unix))]
+    #[test]
+    fn atomic_command_launch_fails_closed_on_unsupported_platform() {
+        assert_eq!(
+            LaunchCommand::new("echo hello".into()).unwrap_err().kind(),
+            std::io::ErrorKind::Unsupported
+        );
+    }
+}
