@@ -0,0 +1,251 @@
+use crate::pane::launch_command::LaunchCommand;
+
+pub(super) fn validate(command: String) -> Result<LaunchCommand, (&'static str, String)> {
+    LaunchCommand::new(command).map_err(|err| {
+        let code = if err.kind() == std::io::ErrorKind::Unsupported {
+            "unsupported_platform"
+        } else {
+            "invalid_command"
+        };
+        (code, err.to_string())
+    })
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use crate::api::schema::Request;
+    use crate::app::App;
+
+    fn app() -> App {
+        let (_, api_rx) = tokio::sync::mpsc::unbounded_channel();
+        let mut app = App::new(
+            &crate::config::Config::default(),
+            crate::app::AppPolicy::TEST,
+            None,
+            api_rx,
+            crate::api::EventHub::default(),
+        );
+        // A command launch must bypass this deliberately invalid default shell.
+        app.state.default_shell = "/missing-herdr-default-shell".into();
+        app
+    }
+
+    fn request(method: &str, params: serde_json::Value) -> Request {
+        serde_json::from_value(serde_json::json!({"id":"atomic","method":method,"params":params}))
+            .unwrap()
+    }
+
+    async fn wait_file(path: &std::path::Path) -> String {
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        loop {
+            if let Ok(text) = std::fs::read_to_string(path) {
+                if !text.is_empty() {
+                    return text;
+                }
+            }
+            assert!(std::time::Instant::now() < deadline, "command did not run");
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }
+
+    #[tokio::test]
+    async fn atomic_command_launch_workspace_tab_spawn_and_restore_do_not_replay() {
+        let root = std::env::temp_dir().join(format!(
+            "herdr-atomic-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let mut app = app();
+        for (method, file) in [
+            ("workspace.create_with_command", "workspace"),
+            ("tab.create_with_command", "tab"),
+        ] {
+            let command = format!("  test -t 0 && printf '%s|%s|%s' \"$LAUNCH_TEST\" \"$PWD\" \"$HERDR_PANE_ID\" > '{file}' ; sleep 30  ");
+            let response = app.handle_api_request(request(method, serde_json::json!({"cwd":root,"focus":true,"env":{"LAUNCH_TEST":"quoted value; literal"},"command":command})));
+            let value: serde_json::Value = serde_json::from_str(&response).unwrap();
+            assert!(value["error"].is_null(), "{response}");
+            assert!(app
+                .terminal_runtimes
+                .values()
+                .all(|runtime| runtime.child_pid().is_some()));
+            let text = wait_file(&root.join(file)).await;
+            assert!(
+                text.starts_with(&format!("quoted value; literal|{}|", root.display())),
+                "{text}"
+            );
+            assert!(!text.ends_with('|'));
+        }
+        assert!(app
+            .state
+            .terminals
+            .values()
+            .all(|terminal| terminal.launch_argv.is_none()));
+        let snapshot = crate::persist::capture(
+            &app.state.workspaces,
+            &app.state.terminals,
+            &app.terminal_runtimes,
+            app.state.active,
+            app.state.selected,
+        );
+        let json = serde_json::to_string(&snapshot).unwrap();
+        assert!(!json.contains("LAUNCH_TEST") && !json.contains("sleep 30"));
+        super::super::test_support::shutdown_test_runtimes(&mut app);
+        std::fs::remove_file(root.join("workspace")).unwrap();
+        std::fs::remove_file(root.join("tab")).unwrap();
+        let (tx, _rx) = tokio::sync::mpsc::channel(32);
+        let (_, _, runtimes) = crate::persist::restore(
+            &snapshot,
+            None,
+            24,
+            80,
+            1024 * 1024,
+            "/usr/bin/true",
+            crate::config::ShellModeConfig::NonLogin,
+            false,
+            tx,
+            std::sync::Arc::new(tokio::sync::Notify::new()),
+            std::sync::Arc::new(crate::render_signal::RenderSignal::default()),
+        );
+        tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        assert!(!root.join("workspace").exists() && !root.join("tab").exists());
+        for (_, runtime) in runtimes {
+            runtime.shutdown();
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[tokio::test]
+    async fn atomic_command_launch_completed_panes_keep_output_without_replay() {
+        let root = std::env::temp_dir().join(format!(
+            "herdr-completed-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        std::fs::create_dir_all(&root).unwrap();
+        let mut app = app();
+        for (method, ending) in [
+            ("workspace.create_with_command", "true"),
+            ("tab.create_with_command", "false"),
+            (
+                "tab.create_with_command",
+                "herdr_missing_executable_for_launch_test",
+            ),
+        ] {
+            let command = format!("printf x >> executions ; printf retained-output ; {ending}");
+            let response = app.handle_api_request_after_internal_events_drained(request(
+                method,
+                serde_json::json!({"cwd":root,"command":command}),
+            ));
+            assert!(
+                serde_json::from_str::<serde_json::Value>(&response).unwrap()["error"].is_null(),
+                "{response}"
+            );
+        }
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        let mut exits = 0;
+        while exits < 3 {
+            while let Ok(event) = app.event_rx.try_recv() {
+                if matches!(&event, crate::events::AppEvent::PaneDied { .. }) {
+                    exits += 1;
+                }
+                app.handle_internal_event(event);
+            }
+            assert!(std::time::Instant::now() < deadline);
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+        assert_eq!(app.state.workspaces.len(), 1);
+        assert_eq!(app.state.workspaces[0].tabs.len(), 3);
+        assert_eq!(app.terminal_runtimes.len(), 3);
+        let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+        while !app.terminal_runtimes.values().all(|runtime| {
+            runtime
+                .recent_text_snapshot(40)
+                .text
+                .contains("retained-output")
+        }) {
+            assert!(std::time::Instant::now() < deadline);
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+        assert!(app.terminal_runtimes.values().any(|runtime| runtime
+            .recent_text_snapshot(40)
+            .text
+            .contains("herdr_missing_executable_for_launch_test")));
+        assert_eq!(
+            std::fs::read_to_string(root.join("executions")).unwrap(),
+            "xxx"
+        );
+        assert!(app
+            .state
+            .terminals
+            .values()
+            .all(|terminal| terminal.retain_on_exit && terminal.launch_argv.is_none()));
+        let snapshot = crate::persist::capture(
+            &app.state.workspaces,
+            &app.state.terminals,
+            &app.terminal_runtimes,
+            app.state.active,
+            app.state.selected,
+        );
+        let json = serde_json::to_string(&snapshot).unwrap();
+        assert!(!json.contains("retain_on_exit") && !json.contains("printf x >> executions"));
+        super::super::test_support::shutdown_test_runtimes(&mut app);
+        let (tx, _rx) = tokio::sync::mpsc::channel(32);
+        let (_, terminals, runtimes) = crate::persist::restore(
+            &snapshot,
+            None,
+            24,
+            80,
+            1024 * 1024,
+            "/usr/bin/true",
+            crate::config::ShellModeConfig::NonLogin,
+            false,
+            tx,
+            std::sync::Arc::new(tokio::sync::Notify::new()),
+            std::sync::Arc::new(crate::render_signal::RenderSignal::default()),
+        );
+        assert!(terminals.values().all(|terminal| !terminal.retain_on_exit));
+        tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+        assert_eq!(
+            std::fs::read_to_string(root.join("executions")).unwrap(),
+            "xxx"
+        );
+        for (_, runtime) in runtimes {
+            runtime.shutdown();
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+
+    #[tokio::test]
+    async fn atomic_command_launch_invalid_requests_publish_nothing() {
+        let mut app = app();
+        for method in ["workspace.create_with_command", "tab.create_with_command"] {
+            for command in ["", "  ", "printf x\nexit", "x\u{2028}y"] {
+                let response =
+                    app.handle_api_request(request(method, serde_json::json!({"command":command})));
+                let value: serde_json::Value = serde_json::from_str(&response).unwrap();
+                assert_eq!(value["error"]["code"], "invalid_command");
+                assert!(app.state.workspaces.is_empty());
+                assert_eq!(app.terminal_runtimes.len(), 0);
+            }
+        }
+        let response = app.handle_api_request(request(
+            "workspace.create_with_command",
+            // portable-pty falls back to HOME for a nonexistent cwd. Make both
+            // paths nonexistent to force chdir failure without global overrides.
+            serde_json::json!({"command":"printf secret","cwd":"/missing-herdr-command-cwd","env":{"HOME":"/missing-herdr-command-home"}}),
+        ));
+        assert!(
+            serde_json::from_str::<serde_json::Value>(&response).unwrap()["error"].is_object(),
+            "{response}"
+        );
+        assert!(!response.contains("printf secret"));
+        assert!(app.state.workspaces.is_empty());
+    }
+}
