@@ -0,0 +1,141 @@
+fn run_command_request(app: &mut App, request: Request) -> String {
+    let (respond_to, response_rx) = response_channel();
+    assert!(app.handle_deferred_worktree_api_request(request, respond_to, false));
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    loop {
+        if let Ok(response) = response_rx.try_recv() {
+            return response;
+        }
+        if let Ok(event) = app.event_rx.try_recv() {
+            app.handle_internal_event(event);
+        }
+        assert!(
+            std::time::Instant::now() < deadline,
+            "command request timed out"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(10));
+    }
+}
+
+#[tokio::test]
+#[cfg(unix)]
+async fn atomic_command_launch_worktree_create_and_open_use_initial_pty() {
+    let repo = create_committed_repo("atomic-worktree-repo");
+    let checkout = unique_temp_path("atomic-worktree-checkout");
+    let mut app = app_with_parent(&repo);
+    let command =
+        r#"test -t 0 && printf '%s|%s' "$PWD" "$HERDR_PANE_ID" > atomic-marker ; sleep 30"#;
+    let request: Request = serde_json::from_value(serde_json::json!({
+        "id":"command-create", "method":"worktree.create_with_command",
+        "params":{"cwd":repo,"branch":"atomic-command","path":checkout,"command":command}
+    }))
+    .unwrap();
+    let response = run_command_request(&mut app, request);
+    let success: SuccessResponse =
+        serde_json::from_str(&response).unwrap_or_else(|err| panic!("{err}: {response}"));
+    assert!(matches!(
+        success.result,
+        ResponseResult::WorktreeCreated { .. }
+    ));
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    while !std::fs::read_to_string(checkout.join("atomic-marker"))
+        .is_ok_and(|text| !text.is_empty())
+    {
+        assert!(std::time::Instant::now() < deadline);
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+    let text = std::fs::read_to_string(checkout.join("atomic-marker")).unwrap();
+    assert!(
+        text.starts_with(&format!("{}|", checkout.display())),
+        "{text}"
+    );
+    assert!(!text.ends_with('|'));
+    super::super::test_support::shutdown_test_runtimes(&mut app);
+    drop(app);
+    std::fs::remove_file(checkout.join("atomic-marker")).unwrap();
+    let mut app = app_with_parent(&repo);
+    let open = || {
+        serde_json::from_value::<Request>(serde_json::json!({
+            "id":"command-open", "method":"worktree.open_with_command",
+            "params":{"cwd":repo,"path":checkout,"command":command}
+        }))
+        .unwrap()
+    };
+    let response = run_command_request(&mut app, open());
+    let success: SuccessResponse = serde_json::from_str(&response).unwrap();
+    assert!(matches!(
+        success.result,
+        ResponseResult::WorktreeOpened {
+            already_open: false,
+            ..
+        }
+    ));
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    while !std::fs::read_to_string(checkout.join("atomic-marker"))
+        .is_ok_and(|text| !text.is_empty())
+    {
+        assert!(std::time::Instant::now() < deadline);
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+    let count = app.state.workspaces.len();
+    let active = app.state.active;
+    let response = run_command_request(&mut app, open());
+    let value: serde_json::Value = serde_json::from_str(&response).unwrap();
+    assert_eq!(value["error"]["code"], "command_target_already_open");
+    assert_eq!(app.state.workspaces.len(), count);
+    assert_eq!(app.state.active, active);
+    super::super::test_support::shutdown_test_runtimes(&mut app);
+    drop(app);
+    let _ = std::fs::remove_dir_all(checkout);
+    let _ = std::fs::remove_dir_all(repo);
+}
+
+#[tokio::test]
+#[cfg(unix)]
+async fn atomic_command_launch_worktree_invalid_is_precreate() {
+    let repo = create_committed_repo("atomic-invalid-repo");
+    let checkout = unique_temp_path("atomic-invalid-checkout");
+    let mut app = app_with_parent(&repo);
+    for method in ["worktree.create_with_command", "worktree.open_with_command"] {
+        let request: Request = serde_json::from_value(serde_json::json!({"id":"bad","method":method,"params":{"cwd":repo,"path":checkout,"command":"printf x\nexit"}})).unwrap();
+        let response = run_command_request(&mut app, request);
+        assert_eq!(
+            serde_json::from_str::<serde_json::Value>(&response).unwrap()["error"]["code"],
+            "invalid_command"
+        );
+        assert!(!checkout.exists());
+        assert_eq!(app.state.workspaces.len(), 1);
+        assert_eq!(app.terminal_runtimes.len(), 0);
+    }
+    let _ = std::fs::remove_dir_all(repo);
+}
+
+#[tokio::test]
+async fn atomic_command_launch_worktree_open_source_uses_command() {
+    let repo = create_committed_repo("atomic-source-open");
+    let mut app = test_app();
+    app.state.default_shell = "/missing-herdr-default-shell".into();
+    let request = serde_json::from_value(serde_json::json!({
+        "id":"source-command", "method":"worktree.open_with_command",
+        "params":{"cwd":repo,"path":repo,"command":"test -t 0 && printf launched > atomic-marker ; sleep 30"}
+    })).unwrap();
+    let response = run_command_request(&mut app, request);
+    assert!(
+        serde_json::from_str::<serde_json::Value>(&response).unwrap()["error"].is_null(),
+        "{response}"
+    );
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(5);
+    while std::fs::read_to_string(repo.join("atomic-marker"))
+        .ok()
+        .as_deref()
+        != Some("launched")
+    {
+        assert!(std::time::Instant::now() < deadline);
+        tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+    }
+    assert_eq!(app.state.workspaces.len(), 1);
+    assert_eq!(app.terminal_runtimes.len(), 1);
+    super::super::test_support::shutdown_test_runtimes(&mut app);
+    drop(app);
+    let _ = std::fs::remove_dir_all(repo);
+}
